# Server port
PORT=4000

# Web3Forms key used by the contact form (required for email delivery)
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Optional: use a custom GitHub username (defaults to BaraaAlArab)
# GITHUB_USERNAME=BaraaAlArab

# Optional: GitHub token to raise the API rate limit (never required for small sites)
# GITHUB_TOKEN=ghp_xxxxxxxx

# Optional: year you started coding professionally (drives the "Years Coding" stat)
# START_YEAR=2019